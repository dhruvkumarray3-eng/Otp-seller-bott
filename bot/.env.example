# Telegram BotFather token. Keep this in Replit Secrets; never commit it.
BOT_TOKEN=

# Optional public GitHub Pages URL for your own terms.html.
# Leave blank to use the in-chat terms page.
TERMS_URL=

# Public channel links. Empty values are not shown in the bot.
UPDATES_CHANNEL_URL=
SUPPORT_CHANNEL_URL=
COMMUNITY_CHANNEL_URL=

# Set to false only if a Telegram client rejects the optional button style field.
COLOR_BUTTONS=true

# HTTP health server port for uptime monitors.
PORT=8080

# Root folder to push. Default is this bot folder.
PUSH_ROOT=bot
# Optional path prefix inside the destination repository.
PUSH_REMOTE_ROOT=bot